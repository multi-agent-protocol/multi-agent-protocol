  "tiers": {
    "core": {
      "description": "Required methods for basic MAP functionality",
      "required": true
    },
    "structure": {
      "description": "Methods for agent lifecycle and system structure management",
      "required": false
    },
    "extension": {
      "description": "Optional extension methods for advanced features",
      "required": false
    }
  }
