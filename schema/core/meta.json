{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-Agent Protocol Method Metadata (Core)",
  "description": "Core machinery methods. Extensions live in schema/ext/<name>/manifest.json (docs/map-ext.md).",
  "protocolVersion": 1,
  "methods": {
    "map/connect": {
      "tier": "core",
      "stability": "stable",
      "implementedBy": "system",
      "callableBy": [
        "client",
        "agent",
        "gateway"
      ],
      "capabilities": [],
      "description": "Connect to the MAP system and negotiate capabilities",
      "requestType": "ConnectRequest",
      "responseType": "ConnectResponse"
    },
    "map/disconnect": {
      "tier": "core",
      "stability": "stable",
      "implementedBy": "system",
      "callableBy": [
        "client",
        "agent",
        "gateway"
      ],
      "capabilities": [],
      "description": "Gracefully disconnect from the MAP system",
      "requestType": "DisconnectRequest",
      "responseType": "DisconnectResponse"
    },
    "map/agents/list": {
      "tier": "core",
      "stability": "stable",
