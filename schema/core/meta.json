      "tier": "structure",
      "stability": "stable",
      "implementedBy": "system",
      "callableBy": [
        "client",
        "agent"
      ],
      "capabilities": [
        "observation.canQuery"
      ],
      "description": "Get the agent relationship graph",
      "requestType": "StructureGraphRequest",
      "responseType": "StructureGraphResponse"
