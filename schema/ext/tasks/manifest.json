    "map/tasks/update": {
      "tier": "extension",
      "stability": "staging",
      "implementedBy": "system",
      "callableBy": [
        "client",
        "agent"
      ],
      "capabilities": [
        "tasks.canUpdate"
      ],
      "description": "Update task status, fields, or provider metadata",
      "requestType": "TasksUpdateRequest",
      "responseType": "TasksUpdateResponse"
    },
    "map/tasks/list": {
      "tier": "extension",
      "stability": "staging",
      "implementedBy": "system",
      "callableBy": [
        "client",
        "agent"
      ],
      "capabilities": [
        "tasks.canList"
