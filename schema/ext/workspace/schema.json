{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-extension": "workspace",
  "$comment": "Message schemas for the workspace MAP extension (docs/map-ext.md). Merged into schema/schema.json by scripts/build-schema.mjs.",
  "$defs": {
    "WorkspaceSearchRequest": {
      "type": "object",
      "x-method": "workspace/search",
      "x-tier": "extension",
      "description": "Search for files matching a query in an agent's workspace",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "workspace/search"
        },
        "params": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "description": "Agent whose workspace to search"
            },
            "query": {
              "type": "string",
              "description": "Search query (matched against filenames)"
            },
            "cwd": {
              "type": "string",
              "description": "Subdirectory to search within (relative to workspace root)"
            },
            "limit": {
              "type": "integer",
              "description": "Max results to return (default 50)"
            },
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "agentId",
            "query"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "WorkspaceListRequest": {
      "type": "object",
      "x-method": "workspace/list",
      "x-tier": "extension",
      "description": "List files in a directory of an agent's workspace",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "workspace/list"
        },
        "params": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "description": "Agent whose workspace to list"
            },
            "directory": {
              "type": "string",
              "description": "Directory to list (relative to workspace root, default '.')"
            },
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "agentId"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "WorkspaceReadRequest": {
      "type": "object",
      "x-method": "workspace/read",
      "x-tier": "extension",
      "description": "Read file contents from an agent's workspace",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "workspace/read"
        },
        "params": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "description": "Agent whose workspace to read from"
            },
            "path": {
              "type": "string",
              "description": "File path relative to workspace root"
            },
            "lineRange": {
              "type": "object",
              "description": "Optional line range to read (1-indexed)",
              "properties": {
                "start": {
                  "type": "integer",
                  "description": "Start line (1-indexed, inclusive)"
                },
                "end": {
                  "type": "integer",
                  "description": "End line (1-indexed, inclusive)"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "agentId",
            "path"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    }
  }
}
