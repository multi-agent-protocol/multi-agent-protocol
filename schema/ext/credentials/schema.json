{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-extension": "credentials",
  "$comment": "Message schemas for the credentials MAP extension (docs/map-ext.md). Merged into schema/schema.json by scripts/build-schema.mjs.",
  "$defs": {
    "CredGetRequest": {
      "type": "object",
      "x-method": "cred/get",
      "x-tier": "extension",
      "description": "Request a short-lived credential for a scope and resource",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "cred/get"
        },
        "params": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "description": "Scope to request (e.g. 'github:repo:write')"
            },
            "resource": {
              "type": "string",
              "description": "Resource to access (e.g. 'acme-corp/frontend')"
            },
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "scope",
            "resource"
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "CredListRequest": {
      "type": "object",
      "x-method": "cred/list",
      "x-tier": "extension",
      "description": "List available scopes for the authenticated token",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "cred/list"
        },
        "params": {
          "type": "object",
          "properties": {
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          }
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    },
    "CredStatusRequest": {
      "type": "object",
      "x-method": "cred/status",
      "x-tier": "extension",
      "description": "Check credential broker status and available providers",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "cred/status"
        },
        "params": {
          "type": "object",
          "properties": {
            "_meta": {
              "$ref": "#/$defs/Meta"
            }
          }
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    }
  }
}
