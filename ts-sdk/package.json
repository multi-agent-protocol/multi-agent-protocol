{
  "name": "@multi-agent-protocol/sdk",
  "version": "0.0.5",
  "type": "module",
  "description": "TypeScript SDK for the Multi-Agent Protocol (MAP)",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate.js",
    "prepublishOnly": "npm run build",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "publish:npm": "npm run build && npm publish --access public"
  },
  "keywords": [
    "multi-agent",
    "agent",
    "protocol",
    "map",
    "sdk",
    "typescript"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-agent-protocol/multi-agent-protocol.git",
    "directory": "ts-sdk"
  },
  "bugs": {
    "url": "https://github.com/multi-agent-protocol/multi-agent-protocol/issues"
  },
  "homepage": "https://github.com/multi-agent-protocol/multi-agent-protocol#readme",
  "dependencies": {
    "ulid": "^3.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.61.0",
    "@types/node": "^20.11.0",
    "json-schema-to-zod": "^2.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
